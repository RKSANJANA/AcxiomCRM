@page
@model Acxiom.Web.Pages.Account.LoginModel
@inject IWebHostEnvironment Env
@{ ViewData["Title"] = "Sign in"; }

<div class="auth-wrap">
    <div class="text-center mb-4">
        <i class="bi bi-diagram-3-fill fs-1 text-primary"></i>
        <h1 class="mt-2">Acxiom CRM</h1>
        <p class="text-muted">Sign in to continue</p>
    </div>
    <div class="panel">
        @if (Model.LockedMessage != null)
        {
            <div class="alert alert-danger small">@Model.LockedMessage</div>
        }
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Input.Email"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Input.Remember" class="form-check-input" />
                <label asp-for="Input.Remember" class="form-check-label"></label>
            </div>
            <button class="btn btn-primary w-100">Sign in</button>
        </form>
    </div>
    <p class="text-center small mt-3">No account yet? <a asp-page="Register">Register</a></p>
    @if (Env.IsDevelopment())
    {
        <p class="text-center small text-muted">Demo users: admin@@ / meera@@ / ravi@@acxiom.test (password in appsettings.Development.json)</p>
    }
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
