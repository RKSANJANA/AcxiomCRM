@page
@model Acxiom.Web.Pages.Account.PasswordModel
@{ ViewData["Title"] = "Change password"; }
<div class="auth-wrap mt-0">
    <h1>Change password</h1>
    <div class="panel">
        <form method="post" novalidate>
            <div class="mb-3">
                <label asp-for="Input.Current" class="form-label"></label>
                <input asp-for="Input.Current" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Current"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.New" class="form-label"></label>
                <input asp-for="Input.New" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.New"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Confirm" class="form-label"></label>
                <input asp-for="Input.Confirm" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.Confirm"></span>
            </div>
            <button class="btn btn-primary">Save</button>
            <a href="/" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
