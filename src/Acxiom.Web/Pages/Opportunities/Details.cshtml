@page "{id:int}"
@model Acxiom.Web.Pages.Opportunities.DetailsModel
@{ var o = Model.Deal; ViewData["Title"] = o.Name; var open = o.Status == OpportunityStatus.Open; }

<div class="page-head">
    <div>
        <h1 class="mb-0">@o.Name <status-pill value="@o.Stage" /></h1>
        <a asp-page="/Customers/Details" asp-route-id="@o.CustomerId" class="link-secondary">@o.CustomerName</a>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (open)
        {
            <a asp-page="/FollowUps/Edit" asp-route-target="Opportunity" asp-route-targetId="@o.Id" class="btn btn-sm btn-outline-primary">Schedule follow-up</a>
            <a asp-page="Edit" asp-route-id="@o.Id" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> Edit / move stage</a>
        }
        @if (Model.Me.CanDelete)
        {
            <partial name="_DeleteButton" model='("Delete", "this opportunity")' />
        }
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="stat"><div class="lbl">Amount</div><div class="num">@o.Amount.Inr()</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="lbl">Probability</div><div class="num">@o.Probability%</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="lbl">Weighted</div><div class="num">@o.Weighted.Inr()</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="lbl">@(open ? "Expected close" : "Closed")</div><div class="num fs-5">@(open ? o.ExpectedCloseDate.Day() : o.ClosedAt.Day())</div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="panel">
            <dl class="facts mb-0">
                <dt>Owner</dt><dd>@o.OwnerName</dd>
                <dt>Source</dt><dd>@(o.Source?.ToString() ?? "-")</dd>
                @if (o.LeadId != null) { <dt>From lead</dt><dd><a asp-page="/Leads/Details" asp-route-id="@o.LeadId">view lead</a></dd> }
                <dt>Created</dt><dd>@o.CreatedAt.Stamp()</dd>
                @if (o.Notes != null) { <dt>Notes</dt><dd style="white-space:pre-line">@o.Notes</dd> }
            </dl>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="panel">
            <h2 class="h6">Follow-ups</h2>
            @if (Model.FollowUps.Count == 0) { <p class="small text-muted mb-0">None scheduled.</p> }
            @foreach (var f in Model.FollowUps)
            {
                <div class="d-flex justify-content-between border-bottom py-2">
                    <span><a asp-page="/FollowUps/Details" asp-route-id="@f.Id">@f.Subject</a> <span class="small text-muted">@f.DueAt.Stamp()</span></span>
                    <status-pill value="@(f.Overdue ? "Overdue" : f.Status.ToString())" />
                </div>
            }
        </div>
        <partial name="_History" model="Model.History" />
    </div>
</div>
