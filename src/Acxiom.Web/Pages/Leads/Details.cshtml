@page "{id:int}"
@model Acxiom.Web.Pages.Leads.DetailsModel
@{ var l = Model.Lead; ViewData["Title"] = l.Name; }

<div class="page-head">
    <div>
        <div class="small text-muted">@l.Code</div>
        <h1 class="mb-0">@l.Name <status-pill value="@l.Status" /></h1>
        <div class="text-muted">@l.Company</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (l.CanConvert)
        {
            <a asp-page="Convert" asp-route-id="@l.Id" class="btn btn-sm btn-success"><i class="bi bi-arrow-right-circle"></i> Convert</a>
        }
        @if (!l.IsClosed)
        {
            <a asp-page="/FollowUps/Edit" asp-route-target="Lead" asp-route-targetId="@l.Id" class="btn btn-sm btn-outline-primary">Schedule follow-up</a>
            <a asp-page="/Activities/Edit" asp-route-leadId="@l.Id" class="btn btn-sm btn-outline-primary">Log activity</a>
            <a asp-page="Edit" asp-route-id="@l.Id" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        }
        @if (Model.Me.CanDelete)
        {
            <partial name="_DeleteButton" model='("Delete", "this lead")' />
        }
    </div>
</div>

@if (l.Status == LeadStatus.Converted)
{
    <div class="alert alert-success">
        Converted on @l.ConvertedAt.Day() -
        <a asp-page="/Customers/Details" asp-route-id="@l.CustomerId">customer</a> and
        <a asp-page="/Opportunities/Details" asp-route-id="@l.OpportunityId">opportunity</a>.
    </div>
}
else if (!l.IsClosed)
{
    <div class="small text-muted mb-3">Can move to: @string.Join(", ", l.NextStatuses)@(l.CanConvert ? ", or be converted" : "")</div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="panel">
            <dl class="facts mb-0">
                <dt>Email</dt><dd>@(l.Email ?? "-")</dd>
                <dt>Phone</dt><dd>@(l.Phone ?? "-")</dd>
                <dt>Source</dt><dd>@StatusPillTagHelper.Spaced(l.Source.ToString())</dd>
                <dt>Priority</dt><dd><status-pill value="@l.Priority" /></dd>
                <dt>Expected value</dt><dd>@l.ExpectedValue.Inr()</dd>
                <dt>Assigned to</dt><dd>@l.OwnerName</dd>
                <dt>Created</dt><dd>@l.CreatedAt.Stamp()</dd>
                @if (l.Notes != null) { <dt>Notes</dt><dd style="white-space:pre-line">@l.Notes</dd> }
            </dl>
        </div>
        <partial name="_History" model="Model.History" />
    </div>
    <div class="col-lg-8">
        <div class="panel">
            <h2 class="h6">Follow-ups</h2>
            @if (Model.FollowUps.Count == 0) { <p class="small text-muted mb-0">None scheduled.</p> }
            @foreach (var f in Model.FollowUps)
            {
                <div class="d-flex justify-content-between border-bottom py-2">
                    <span><a asp-page="/FollowUps/Details" asp-route-id="@f.Id">@f.Subject</a> <span class="small text-muted">@f.DueAt.Stamp()</span></span>
                    <status-pill value="@(f.Overdue ? "Overdue" : f.Status.ToString())" />
                </div>
            }
        </div>
        <div class="panel">
            <h2 class="h6">Activity</h2>
            @if (Model.Activities.Count == 0) { <p class="small text-muted mb-0">Nothing logged.</p> }
            @foreach (var a in Model.Activities)
            {
                <div class="border-bottom py-2 small"><strong>@a.Type</strong> · @a.Subject <span class="text-muted">· @a.When.Stamp()</span></div>
            }
        </div>
    </div>
</div>
