@page "{id:int?}"
@model Acxiom.Web.Pages.Leads.EditModel
@{ ViewData["Title"] = Model.Id == null ? "New lead" : "Edit lead"; }

<h1>@ViewData["Title"]</h1>
<form method="post" class="panel" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" />
            <span asp-validation-for="Input.Name"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Company" class="form-label"></label>
            <input asp-for="Input.Company" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" inputmode="email" />
            <span asp-validation-for="Input.Email"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Phone" class="form-label"></label>
            <input asp-for="Input.Phone" class="form-control" inputmode="numeric" maxlength="10" />
            <span asp-validation-for="Input.Phone"></span>
            <div class="form-text">Email or phone - at least one.</div>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.Source" class="form-label"></label>
            <select asp-for="Input.Source" class="form-select" asp-items="Lists.Of(Model.Input.Source)"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.Status" class="form-label"></label>
            <select asp-for="Input.Status" class="form-select" asp-items="Lists.Of(Model.Input.Status, Model.StatusChoices)"></select>
            <span asp-validation-for="Input.Status"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.Priority" class="form-label"></label>
            <select asp-for="Input.Priority" class="form-select" asp-items="Lists.Of(Model.Input.Priority)"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.ExpectedValue" class="form-label"></label>
            <input asp-for="Input.ExpectedValue" class="form-control" type="text" inputmode="decimal" />
            <span asp-validation-for="Input.ExpectedValue"></span>
        </div>
        @if (Model.Owners.Count > 0)
        {
            <div class="col-md-6">
                <label asp-for="Input.OwnerId" class="form-label"></label>
                <select asp-for="Input.OwnerId" class="form-select" asp-items="Lists.Of(Model.Owners, Model.Input.OwnerId)"></select>
                <span asp-validation-for="Input.OwnerId"></span>
            </div>
        }
        <div class="col-12">
            <label asp-for="Input.Notes" class="form-label"></label>
            <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
        </div>
    </div>
    <div class="mt-4">
        <button class="btn btn-primary">Save</button>
        <a class="btn btn-link" href="@(Model.Id == null ? "/Leads" : $"/Leads/Details/{Model.Id}")">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
