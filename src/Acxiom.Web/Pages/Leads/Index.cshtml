@page
@model Acxiom.Web.Pages.Leads.IndexModel
@{ ViewData["Title"] = "Leads"; var f = Model.Filter; }

<div class="page-head">
    <h1>Leads</h1>
    <a asp-page="Edit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New lead</a>
</div>

<form method="get" class="filters row g-2 align-items-center">
    <div class="col-md-4"><input name="Q" value="@f.Q" class="form-control" placeholder="Search name, company, email…" aria-label="Search" /></div>
    <div class="col-md-2"><select name="Status" class="form-select" asp-items="Lists.Of(f.Status)" aria-label="Status"><option value="">Any status</option></select></div>
    <div class="col-md-2"><select name="Source" class="form-select" asp-items="Lists.Of(f.Source)" aria-label="Source"><option value="">Any source</option></select></div>
    @if (Model.Owners.Count > 0)
    {
        <div class="col-md-3"><select name="Owner" class="form-select" asp-items="Lists.Of(Model.Owners, f.Owner)" aria-label="Assigned to"><option value="">Anyone</option></select></div>
    }
    <div class="col-md-auto"><button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button></div>
</form>

<div class="table-wrap">
    <table class="table table-hover grid align-middle">
        <thead>
        <tr>
            <th sort="name">Lead</th>
            <th sort="company">Company</th>
            <th sort="source">Source</th>
            <th sort="status">Status</th>
            <th sort="priority">Priority</th>
            <th sort="value" class="text-end">Expected</th>
            <th>Assigned to</th>
            <th sort="created">Created</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var l in Model.Result.Items)
        {
            <tr>
                <td><a asp-page="Details" asp-route-id="@l.Id" class="fw-semibold">@l.Name</a><div class="small text-muted">@l.Code</div></td>
                <td>@l.Company</td>
                <td>@StatusPillTagHelper.Spaced(l.Source.ToString())</td>
                <td><status-pill value="@l.Status" /></td>
                <td><status-pill value="@l.Priority" /></td>
                <td class="text-end">@l.ExpectedValue.Inr()</td>
                <td>@l.OwnerName</td>
                <td class="small">@l.CreatedAt.Day()</td>
            </tr>
        }
        @if (Model.Result.Total == 0)
        {
            <tr><td colspan="8" class="text-center text-muted py-4">No leads match.</td></tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="(Model.Result.Page, Model.Result.Pages, Model.Result.Total)" />
