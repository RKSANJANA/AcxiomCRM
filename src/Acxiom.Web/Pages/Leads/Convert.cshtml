@page "{id:int}"
@model Acxiom.Web.Pages.Leads.ConvertModel
@{ ViewData["Title"] = "Convert lead"; }

<h1>Convert @Model.Lead.Name</h1>
<p class="text-muted">This creates the customer (or reuses one with the same email/phone) and opens an opportunity in the Qualification stage.</p>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="panel h-100">
                <h2 class="h6">Customer</h2>
                <div class="mb-3">
                    <label asp-for="Input.Name" class="form-label"></label>
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Company" class="form-label"></label>
                    <input asp-for="Input.Company" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" inputmode="email" />
                    <span asp-validation-for="Input.Email"></span>
                </div>
                <div>
                    <label asp-for="Input.Phone" class="form-label"></label>
                    <input asp-for="Input.Phone" class="form-control" inputmode="numeric" maxlength="10" />
                    <span asp-validation-for="Input.Phone"></span>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="panel h-100">
                <h2 class="h6">Opportunity</h2>
                <div class="mb-3">
                    <label asp-for="Input.DealName" class="form-label"></label>
                    <input asp-for="Input.DealName" class="form-control" />
                    <span asp-validation-for="Input.DealName"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.Amount" class="form-label"></label>
                        <input asp-for="Input.Amount" class="form-control" type="text" inputmode="decimal" />
                        <span asp-validation-for="Input.Amount"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Probability" class="form-label"></label>
                        <input asp-for="Input.Probability" class="form-control" type="text" inputmode="numeric" />
                        <span asp-validation-for="Input.Probability"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.CloseDate" class="form-label"></label>
                        <input asp-for="Input.CloseDate" class="form-control" />
                        <span asp-validation-for="Input.CloseDate"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-success">Convert lead</button>
        <a asp-page="Details" asp-route-id="@Model.Lead.Id" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
