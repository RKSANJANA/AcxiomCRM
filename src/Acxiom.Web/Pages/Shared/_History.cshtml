@model List<Acxiom.Domain.Auditing.AuditEntry>
<h2 class="h6 mt-4 text-uppercase text-muted">History</h2>
@if (Model.Count == 0)
{
    <p class="small text-muted">Nothing recorded yet.</p>
}
<ul class="timeline small">
    @foreach (var e in Model)
    {
        <li>
            <strong>@e.Action</strong> by @(e.UserName ?? "system")
            <span class="text-muted">· @e.CreatedDate.Stamp()</span>
            @if (e.Note != null) { <div class="text-muted">@e.Note</div> }
        </li>
    }
</ul>
