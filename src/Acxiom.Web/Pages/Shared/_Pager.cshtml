@model (int Page, int Pages, int Total)
@{
    var req = ViewContext.HttpContext.Request;
}
<div class="d-flex justify-content-between align-items-center mt-3 small">
    <span class="text-muted">@Model.Total result@(Model.Total == 1 ? "" : "s")</span>
    @if (Model.Pages > 1)
    {
        <div class="btn-group btn-group-sm">
            <a class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" href="@Links.With(req, ("Page", (Model.Page - 1).ToString()))">‹ Prev</a>
            <span class="btn btn-outline-secondary disabled">@Model.Page / @Model.Pages</span>
            <a class="btn btn-outline-secondary @(Model.Page >= Model.Pages ? "disabled" : "")" href="@Links.With(req, ("Page", (Model.Page + 1).ToString()))">Next ›</a>
        </div>
    }
</div>
