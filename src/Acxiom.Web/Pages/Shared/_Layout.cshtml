@inject Acxiom.Application.ICurrentUser Me
@inject Acxiom.Application.FollowUps.FollowUpHandler FollowUps
@{
    var signedIn = Me.IsAuthenticated;
    var due = signedIn ? await FollowUps.DueCountAsync() : 0;
    var path = Context.Request.Path.Value ?? "";
    string On(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Acxiom CRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (signedIn)
{
    <nav class="navbar navbar-expand-lg navbar-dark topbar">
        <div class="container-xl">
            <a class="navbar-brand fw-bold" asp-page="/Index"><i class="bi bi-diagram-3-fill"></i> Acxiom CRM</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link @(path == "/" || path.StartsWith("/Index") ? "active" : "")" asp-page="/Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link @On("/Customers")" asp-page="/Customers/Index">Customers</a></li>
                    <li class="nav-item"><a class="nav-link @On("/Leads")" asp-page="/Leads/Index">Leads</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @On("/Opportunities")" href="#" data-bs-toggle="dropdown" aria-expanded="false">Opportunities</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-page="/Opportunities/Index">All opportunities</a></li>
                            <li><a class="dropdown-item" asp-page="/Opportunities/Board">Pipeline board</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @On("/FollowUps")" asp-page="/FollowUps/Index">
                            Follow-ups @if (due > 0) { <span class="badge rounded-pill text-bg-warning" title="due today or overdue">@due</span> }
                        </a>
                    </li>
                    <li class="nav-item"><a class="nav-link @On("/Activities")" asp-page="/Activities/Index">Activities</a></li>
                    <li class="nav-item"><a class="nav-link @On("/Reports")" asp-page="/Reports/Index">Reports</a></li>
                    @if (Me.IsAdmin)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @On("/Admin")" href="#" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Admin/Users/Index">Users</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Teams">Teams</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Roles">Roles &amp; permissions</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Audit">Audit log</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="/swagger" target="_blank">API (Swagger)</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-light dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person"></i> @Me.Name
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li class="dropdown-item-text small text-muted">@(Me.IsAdmin ? "Admin" : Me.IsManager ? "Manager" : "Sales Executive")</li>
                        <li><a class="dropdown-item" asp-page="/Account/Password">Change password</a></li>
                        <li>
                            <form method="post" asp-page="/Account/Logout"><button class="dropdown-item">Sign out</button></form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
}

<main class="container-xl py-4">
    @RenderBody()
</main>

@if (TempData["toast"] is string toast)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div class="toast show align-items-center text-bg-dark border-0" role="status" aria-live="polite" data-bs-delay="4000">
            <div class="d-flex">
                <div class="toast-body">@toast</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
