@page
@{
    var code = int.TryParse(Request.Query["code"], out var c) ? c : 404;
    var text = code switch
    {
        400 => "That request didn't make sense to us.",
        403 => "You don't have permission for this.",
        404 => "We couldn't find that page or record.",
        429 => "Too many attempts. Wait a minute and try again.",
        _ => "Something went wrong."
    };
    ViewData["Title"] = code.ToString();
}
<div class="text-center py-5">
    <div class="display-5 fw-bold text-muted">@code</div>
    <p class="lead">@text</p>
    <a href="/" class="btn btn-outline-primary">Back to dashboard</a>
</div>
