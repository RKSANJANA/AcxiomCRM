@page
@model Acxiom.Web.Pages.FollowUps.IndexModel
@{
    ViewData["Title"] = "Follow-ups";
    var f = Model.Filter;
    var tabs = new (string? Key, string Label)[] { ("pending", "To do"), ("today", "Today"), ("overdue", "Overdue"), ("upcoming", "Upcoming"), (null, "All") };
}

<div class="page-head">
    <h1>Follow-ups</h1>
    <a asp-page="Edit" class="btn btn-primary"><i class="bi bi-calendar-plus"></i> Schedule</a>
</div>

<ul class="nav nav-underline mb-3">
    @foreach (var t in tabs)
    {
        <li class="nav-item"><a class="nav-link @(f.Due == t.Key ? "active" : "")" href="@Links.With(Request, ("Due", t.Key), ("Page", null))">@t.Label</a></li>
    }
</ul>

<form method="get" class="filters row g-2 align-items-center">
    <input type="hidden" name="Due" value="@f.Due" />
    <div class="col-md-3"><input name="Q" value="@f.Q" class="form-control" placeholder="Search subject…" aria-label="Search" /></div>
    <div class="col-md-2"><select name="Type" class="form-select" asp-items="Lists.Of(f.Type)" aria-label="Type"><option value="">Any type</option></select></div>
    <div class="col-md-2"><select name="Status" class="form-select" asp-items="Lists.Of(f.Status)" aria-label="Status"><option value="">Any status</option></select></div>
    <div class="col-md-2"><input type="date" name="From" value="@f.From?.ToString("yyyy-MM-dd")" class="form-control" aria-label="From" /></div>
    <div class="col-md-2"><input type="date" name="To" value="@f.To?.ToString("yyyy-MM-dd")" class="form-control" aria-label="To" /></div>
    @if (Model.Owners.Count > 0)
    {
        <div class="col-md-3"><select name="Owner" class="form-select" asp-items="Lists.Of(Model.Owners, f.Owner)" aria-label="Assigned to"><option value="">Anyone</option></select></div>
    }
    <div class="col-md-auto"><button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button></div>
</form>

<div class="table-wrap">
    <table class="table table-hover grid align-middle">
        <thead>
        <tr><th sort="due">When</th><th sort="subject">Subject</th><th sort="type">Type</th><th>For</th><th sort="status">Status</th><th>Assigned to</th></tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Result.Items)
        {
            var detailsPage = r.Target switch { TargetKind.Lead => "/Leads/Details", TargetKind.Opportunity => "/Opportunities/Details", _ => "/Customers/Details" };
            <tr>
                <td class="@(r.Overdue ? "text-danger fw-semibold" : "")">@r.DueAt.Stamp()</td>
                <td><a asp-page="Details" asp-route-id="@r.Id">@r.Subject</a></td>
                <td>@r.Type</td>
                <td><span class="small text-muted">@r.Target</span> <a asp-page="@detailsPage" asp-route-id="@r.TargetId" class="link-secondary">@r.TargetName</a></td>
                <td><status-pill value="@(r.Overdue ? "Overdue" : r.Status.ToString())" /></td>
                <td>@r.OwnerName</td>
            </tr>
        }
        @if (Model.Result.Total == 0)
        {
            <tr><td colspan="6" class="text-center text-muted py-4">Nothing here.</td></tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="(Model.Result.Page, Model.Result.Pages, Model.Result.Total)" />
