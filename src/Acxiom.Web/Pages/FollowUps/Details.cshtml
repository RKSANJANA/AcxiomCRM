@page "{id:int}"
@model Acxiom.Web.Pages.FollowUps.DetailsModel
@{
    var f = Model.Item;
    ViewData["Title"] = f.Subject;
    var detailsPage = f.Target switch { TargetKind.Lead => "/Leads/Details", TargetKind.Opportunity => "/Opportunities/Details", _ => "/Customers/Details" };
}

<div class="page-head">
    <div>
        <h1 class="mb-0">@f.Subject <status-pill value="@(f.Overdue ? "Overdue" : f.Status.ToString())" /></h1>
        <div class="text-muted">@f.Type with <a asp-page="@detailsPage" asp-route-id="@f.TargetId">@f.TargetName</a> (@f.Target.ToString().ToLower())</div>
    </div>
    <div class="d-flex gap-2">
        @if (f.Status == FollowUpStatus.Planned)
        {
            <a asp-page="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
        }
        @if (Model.Me.CanDelete)
        {
            <partial name="_DeleteButton" model='("Delete", "this follow-up")' />
        }
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="panel">
            <dl class="facts mb-0">
                <dt>When</dt><dd class="@(f.Overdue ? "text-danger" : "")">@f.DueAt.Stamp()</dd>
                <dt>Assigned to</dt><dd>@f.OwnerName</dd>
                @if (f.CompletedAt != null) { <dt>Completed</dt><dd>@f.CompletedAt.Value.Stamp()</dd> }
                <dt>Remarks</dt><dd style="white-space:pre-line">@(f.Remarks ?? "-")</dd>
            </dl>
        </div>
        <partial name="_History" model="Model.History" />
    </div>
    <div class="col-lg-7">
        @if (f.Status == FollowUpStatus.Planned)
        {
            <form method="post" asp-page-handler="Complete" class="panel" novalidate>
                <h2 class="h6">Mark as done</h2>
                <label asp-for="Done.Outcome" class="form-label small"></label>
                <textarea asp-for="Done.Outcome" class="form-control mb-2" rows="2"></textarea>
                <span asp-validation-for="Done.Outcome"></span>
                <button class="btn btn-success btn-sm">Done</button>
                <span class="small text-muted ms-2">Also logs an activity; a New lead moves to Contacted.</span>
            </form>
        }
        @if (f.Status is FollowUpStatus.Planned or FollowUpStatus.Missed)
        {
            <form method="post" asp-page-handler="Reschedule" class="panel" novalidate>
                <h2 class="h6">Reschedule</h2>
                <div class="row g-2 align-items-end">
                    <div class="col-sm-7">
                        <label asp-for="Move.NewDate" class="form-label small"></label>
                        <input asp-for="Move.NewDate" class="form-control" type="datetime-local" />
                    </div>
                    <div class="col-sm-auto"><button class="btn btn-primary btn-sm">Move</button></div>
                </div>
                <span asp-validation-for="Move.NewDate"></span>
            </form>
        }
        @if (f.Status == FollowUpStatus.Planned)
        {
            <div class="d-flex gap-2 mt-3">
                <form method="post" asp-page-handler="Missed"><button class="btn btn-outline-warning btn-sm">Mark missed</button></form>
                <form method="post" asp-page-handler="Cancel"><button class="btn btn-outline-secondary btn-sm">Cancel follow-up</button></form>
            </div>
        }
        @if (f.Status is FollowUpStatus.Completed or FollowUpStatus.Cancelled)
        {
            <div class="panel text-muted">This follow-up is @f.Status.ToString().ToLower(). Nothing more to do.</div>
        }
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
