@page
@model Acxiom.Web.Pages.Admin.TeamsModel
@{ ViewData["Title"] = "Teams"; }

<h1>Teams</h1>
<p class="text-muted">A manager sees their own records plus those of everyone in the teams they manage. Put people in a team from their user page.</p>

<div class="row g-3">
    <div class="col-lg-7">
        @foreach (var t in Model.Teams)
        {
            var members = Model.Users.Where(u => u.TeamId == t.Id).ToList();
            <div class="panel">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h2 class="h6 mb-1">@t.Name</h2>
                        <div class="small text-muted">Manager: @(t.ManagerName ?? "none")</div>
                    </div>
                    <div class="d-flex gap-1">
                        <a asp-page="Teams" asp-route-edit="@t.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@t.Id" onsubmit="return confirm('Remove @t.Name? Members will have no team.')">
                            <button class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </div>
                </div>
                <div class="mt-2 small">
                    @if (members.Count == 0) { <span class="text-muted">No members yet.</span> }
                    @foreach (var m in members)
                    {
                        <a asp-page="/Admin/Users/Edit" asp-route-id="@m.Id" class="badge text-bg-light border text-decoration-none me-1">@m.FullName</a>
                    }
                </div>
            </div>
        }
        @if (Model.Teams.Count == 0) { <p class="text-muted">No teams yet.</p> }
    </div>
    <div class="col-lg-5">
        <form method="post" class="panel" novalidate>
            <h2 class="h6">@(Model.Input.Id == null ? "New team" : "Edit team")</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <input type="hidden" asp-for="Input.Id" />
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.ManagerId" class="form-label"></label>
                <select asp-for="Input.ManagerId" class="form-select" asp-items="Lists.Of(Model.Managers, Model.Input.ManagerId)"><option value="">No manager</option></select>
                <span asp-validation-for="Input.ManagerId"></span>
            </div>
            <button class="btn btn-primary">Save</button>
            @if (Model.Input.Id != null) { <a asp-page="Teams" class="btn btn-link">New team instead</a> }
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
