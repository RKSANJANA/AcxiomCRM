@page
@inject IEnumerable<Acxiom.Application.Reports.IReport> Reports
@inject Acxiom.Application.ICurrentUser Me
@{ ViewData["Title"] = "Reports"; }

<h1>Reports</h1>
<p class="text-muted">Everything here only includes the records you're allowed to see. Every report can be filtered, sorted and downloaded as CSV.</p>
<div class="list-group">
    @foreach (var r in Reports.Where(r => r.AllowedFor(Me)))
    {
        <a asp-page="Run" asp-route-slug="@r.Slug" class="list-group-item list-group-item-action py-3">
            <div class="fw-semibold">@r.Title</div>
            <div class="small text-muted">@r.Summary</div>
        </a>
    }
</div>
