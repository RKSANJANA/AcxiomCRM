@page
@model Acxiom.Web.Pages.Customers.IndexModel
@{ ViewData["Title"] = "Customers"; var f = Model.Filter; }

<div class="page-head">
    <h1>Customers</h1>
    <a asp-page="Edit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add customer</a>
</div>

<form method="get" class="filters row g-2 align-items-center">
    <div class="col-md-5"><input name="Q" value="@f.Q" class="form-control" placeholder="Search name, email, phone, company…" aria-label="Search" /></div>
    <div class="col-md-3">
        <select name="Status" class="form-select" asp-items="Lists.Of(f.Status)" aria-label="Status"><option value="">Any status</option></select>
    </div>
    @if (Model.Owners.Count > 0)
    {
        <div class="col-md-3">
            <select name="Owner" class="form-select" asp-items="Lists.Of(Model.Owners, f.Owner)" aria-label="Owner"><option value="">Anyone</option></select>
        </div>
    }
    <div class="col-md-auto"><button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button></div>
</form>

<div class="table-wrap">
    <table class="table table-hover grid align-middle">
        <thead>
        <tr>
            <th sort="code">Code</th>
            <th sort="name">Name</th>
            <th sort="company">Company</th>
            <th sort="email">Email</th>
            <th>Phone</th>
            <th sort="status">Status</th>
            <th>Owner</th>
            <th sort="created">Added</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Result.Items)
        {
            <tr>
                <td class="text-muted small">@c.Code</td>
                <td><a asp-page="Details" asp-route-id="@c.Id" class="fw-semibold">@c.Name</a></td>
                <td>@c.Company</td>
                <td>@c.Email</td>
                <td>@c.Phone</td>
                <td><status-pill value="@c.Status" /></td>
                <td>@c.OwnerName</td>
                <td class="small">@c.CreatedAt.Day()</td>
            </tr>
        }
        @if (Model.Result.Total == 0)
        {
            <tr><td colspan="8" class="text-center text-muted py-4">No customers match.</td></tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="(Model.Result.Page, Model.Result.Pages, Model.Result.Total)" />
