@page "{id:int?}"
@model Acxiom.Web.Pages.Customers.EditModel
@{ ViewData["Title"] = Model.Id == null ? "New customer" : "Edit customer"; }

<h1>@ViewData["Title"]</h1>
<form method="post" class="panel" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" />
            <span asp-validation-for="Input.Name"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Company" class="form-label"></label>
            <input asp-for="Input.Company" class="form-control" />
            <span asp-validation-for="Input.Company"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" inputmode="email" />
            <span asp-validation-for="Input.Email"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Phone" class="form-label"></label>
            <input asp-for="Input.Phone" class="form-control" inputmode="numeric" maxlength="10" placeholder="10 digits, e.g. 9876543210" />
            <span asp-validation-for="Input.Phone"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.Address" class="form-label"></label>
            <input asp-for="Input.Address" class="form-control" />
            <span asp-validation-for="Input.Address"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.City" class="form-label"></label>
            <input asp-for="Input.City" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Input.State" class="form-label"></label>
            <input asp-for="Input.State" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Status" class="form-label"></label>
            <select asp-for="Input.Status" class="form-select" asp-items="Lists.Of(Model.Input.Status)"></select>
        </div>
        @if (Model.Owners.Count > 0)
        {
            <div class="col-md-6">
                <label asp-for="Input.OwnerId" class="form-label"></label>
                <select asp-for="Input.OwnerId" class="form-select" asp-items="Lists.Of(Model.Owners, Model.Input.OwnerId)"></select>
                <span asp-validation-for="Input.OwnerId"></span>
            </div>
        }
        <div class="col-12">
            <label asp-for="Input.Notes" class="form-label"></label>
            <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.Notes"></span>
        </div>
    </div>
    <div class="mt-4">
        <button class="btn btn-primary">Save</button>
        <a class="btn btn-link" href="@(Model.Id == null ? "/Customers" : $"/Customers/Details/{Model.Id}")">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
