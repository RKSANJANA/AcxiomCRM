{
  "ConnectionStrings": {
    "Crm": "Data Source=Data/crm.db"
  },
  "Auth": {
    "MinPasswordLength": 8,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "SignInPerMinute": 10
  },
  "Jwt": {
    "Issuer": "acxiom-crm",
    "Audience": "acxiom-crm-api",
    "Minutes": 60
  },
  "Demo": {
    "Seed": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
